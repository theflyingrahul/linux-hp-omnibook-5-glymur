+/*
+ * ACPI (Snapdragon X2 Glymur, QCOM0F88): _CRS describes only the GPIIs that
+ * belong to the application EE, one interrupt per GPII in order, and the
+ * memory window starts @window_skip bytes into the GPI block.
+ */
+struct gpi_acpi_data {
+	u32 ee_offset;
+	u32 window_skip;
+};
+
+static const struct gpi_acpi_data gpi_acpi_glymur = {
+	.ee_offset = 0x10000,
+	.window_skip = 0x4000,
+};
+
+static struct platform_driver gpi_driver;
+static DEFINE_MUTEX(gpi_acpi_lock);
+
+/**
+ * gpi_acpi_request_chan() - request a channel of an ACPI-described GPI engine
+ * @dev: the GPI engine device (for example found through the client's _DEP)
+ * @chid: 0 for TX, 1 for RX
+ * @seid: serial engine index within the QUP
+ * @protocol: QCOM_GPI_* protocol
+ *
+ * ACPI has no equivalent of the DT "dmas" property for GPI; this performs the
+ * same lookup as the DT translation.
+ *
+ * Return: the channel, or an ERR_PTR (-EPROBE_DEFER until the engine binds).
+ */
+struct dma_chan *gpi_acpi_request_chan(struct device *dev, u32 chid, u32 seid,
+				       u32 protocol)
+{
+	struct of_phandle_args args = {
+		.args_count = 3,
+		.args = { chid, seid, protocol },
+	};
+	struct of_dma ofdma = {};
+	struct dma_chan *chan;
+
+	if (dev->driver != &gpi_driver.driver || !dev_get_drvdata(dev))
+		return ERR_PTR(-EPROBE_DEFER);
+
+	ofdma.of_dma_data = dev_get_drvdata(dev);
+	mutex_lock(&gpi_acpi_lock);
+	chan = gpi_of_dma_xlate(&args, &ofdma);
+	mutex_unlock(&gpi_acpi_lock);
+
+	return chan ?: ERR_PTR(-EBUSY);
+}
+EXPORT_SYMBOL_GPL(gpi_acpi_request_chan);
+
+static int gpi_acpi_init(struct platform_device *pdev, struct gpi_dev *gpi_dev,
+			 u32 *ee_offset)
+{
+	const struct gpi_acpi_data *data = device_get_match_data(&pdev->dev);
+	int nirq;
+
+	if (!data)
+		return -ENODEV;
+	if ((gpi_dev->res->start & 0xffff) != data->window_skip)
+		return dev_err_probe(&pdev->dev, -ENODEV,
+				     "unexpected ACPI window %pR\n", gpi_dev->res);
+
+	nirq = platform_irq_count(pdev);
+	if (nirq < 0)
+		return nirq;
+	if (!nirq || nirq > 16)
+		return dev_err_probe(&pdev->dev, -ENODEV, "%d GPII interrupts\n", nirq);
+
+	gpi_dev->max_gpii = nirq;
+	gpi_dev->gpii_mask = GENMASK(nirq - 1, 0);
+	*ee_offset = data->ee_offset + data->window_skip;
+	return 0;
+}
+
 static int gpi_probe(struct platform_device *pdev)
 {
 	struct gpi_dev *gpi_dev;
