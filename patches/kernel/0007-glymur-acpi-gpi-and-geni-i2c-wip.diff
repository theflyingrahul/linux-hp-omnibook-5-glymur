+/* The GPI DMA engine an ACPI SE depends on is listed in its _DEP. */
+static struct device *geni_i2c_acpi_gpi_dev(struct geni_i2c_dev *gi2c)
+{
+	struct acpi_handle_list deps;
+	struct device *gpi = NULL;
+	struct acpi_device *adev;
+	u32 i;
+
+	if (!acpi_evaluate_reference(ACPI_HANDLE(gi2c->se.dev), "_DEP", NULL, &deps))
+		return NULL;
+
+	for (i = 0; i < deps.count && !gpi; i++) {
+		adev = acpi_fetch_acpi_dev(deps.handles[i]);
+		if (adev && acpi_dev_hid_uid_match(adev, "QCOM0F88", NULL))
+			gpi = acpi_get_first_physical_node(adev);
+	}
+	acpi_handle_list_free(&deps);
+	return gpi;
+}
+#else
+static int geni_i2c_acpi_clkd(struct geni_i2c_dev *gi2c)
+{
+	return -ENOENT;
+}
