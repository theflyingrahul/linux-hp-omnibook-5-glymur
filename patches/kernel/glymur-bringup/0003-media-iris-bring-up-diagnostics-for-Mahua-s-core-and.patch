diff --git a/drivers/media/platform/qcom/iris/iris_diag.c b/drivers/media/platform/qcom/iris/iris_diag.c
new file mode 100644
index 000000000000..f3fd83c1bef5
--- /dev/null
+++ b/drivers/media/platform/qcom/iris/iris_diag.c
@@ -0,0 +1,81 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Bring-up diagnostics for Mahua, whose video firmware refuses Glymur's core
+ * and pipe configuration. All off unless a parameter is set.
+ */
+
+#include <linux/device.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+
+#include "iris_core.h"
+#include "iris_diag.h"
+#include "iris_platform_common.h"
+#include "iris_vpu_register_defines.h"
+
+#define WRAPPER_EFUSE_MONITOR	(WRAPPER_BASE_OFFS + 0x08)
+
+static unsigned int diag_cores;
+module_param(diag_cores, uint, 0444);
+MODULE_PARM_DESC(diag_cores, "Video cores to power and use (0: platform value)");
+
+static unsigned int diag_pipes;
+module_param(diag_pipes, uint, 0644);
+MODULE_PARM_DESC(diag_pipes, "HFI_PROP_PIPE value for new sessions (0: platform value)");
+
+static int diag_core_id = -1;
+module_param(diag_core_id, int, 0644);
+MODULE_PARM_DESC(diag_core_id, "HFI_PROP_CORE_ID for new sessions (-1: driver choice, 0: not sent)");
+
+int iris_diag_apply(struct iris_core *core)
+{
+	struct iris_platform_data *plat;
+
+	if (!diag_cores || diag_cores >= core->iris_platform_data->num_cores)
+		return 0;
+
+	plat = devm_kmemdup(core->dev, core->iris_platform_data, sizeof(*plat), GFP_KERNEL);
+	if (!plat)
+		return -ENOMEM;
+
+	plat->num_cores = diag_cores;
+	core->iris_platform_data = plat;
+	dev_info(core->dev, "diag: %u video core(s)\n", diag_cores);
+
+	return 0;
+}
+
+void iris_diag_log_fuses(struct iris_core *core)
+{
+	if (!diag_cores && !diag_pipes && diag_core_id < 0)
+		return;
+
+	dev_info(core->dev, "diag: efuse monitor %#010x, core power status %#010x\n",
+		 readl(core->reg_base + WRAPPER_EFUSE_MONITOR),
+		 readl(core->reg_base + WRAPPER_CORE_POWER_STATUS));
+}
+
+u32 iris_diag_pipes(struct iris_core *core, u32 pipes)
+{
+	u32 val = READ_ONCE(diag_pipes);
+
+	if (!val)
+		return pipes;
+
+	dev_info(core->dev, "diag: HFI_PROP_PIPE %u instead of %u\n", val, pipes);
+
+	return val;
+}
+
+u32 iris_diag_core_id(struct iris_core *core, u32 core_id)
+{
+	int val = READ_ONCE(diag_core_id);
+
+	if (val < 0)
+		return core_id;
+
+	dev_info(core->dev, "diag: HFI_PROP_CORE_ID %d instead of %u\n", val, core_id);
+
+	return val;
+}
diff --git a/drivers/media/platform/qcom/iris/iris_diag.h b/drivers/media/platform/qcom/iris/iris_diag.h
new file mode 100644
index 000000000000..5b45bb9ecd7d
--- /dev/null
+++ b/drivers/media/platform/qcom/iris/iris_diag.h
@@ -0,0 +1,14 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __IRIS_DIAG_H__
+#define __IRIS_DIAG_H__
+
+#include <linux/types.h>
+
+struct iris_core;
+
+int iris_diag_apply(struct iris_core *core);
+void iris_diag_log_fuses(struct iris_core *core);
+u32 iris_diag_pipes(struct iris_core *core, u32 pipes);
+u32 iris_diag_core_id(struct iris_core *core, u32 core_id);
+
+#endif
diff --git a/drivers/media/platform/qcom/iris/iris_probe.c b/drivers/media/platform/qcom/iris/iris_probe.c
index db13ea4308a5..f7af2b3a2d6f 100644
--- a/drivers/media/platform/qcom/iris/iris_probe.c
+++ b/drivers/media/platform/qcom/iris/iris_probe.c
@@ -13,6 +13,7 @@
 #include <linux/soc/qcom/ubwc.h>
 
 #include "iris_debugfs.h"
+#include "iris_diag.h"
 #include "iris_core.h"
 #include "iris_ctrls.h"
 #include "iris_vidc.h"
@@ -380,6 +381,10 @@ static int iris_probe(struct platform_device *pdev)
 
 	core->iris_platform_data = of_device_get_match_data(core->dev);
 
+	ret = iris_diag_apply(core);
+	if (ret)
+		return ret;
+
 	core->ubwc_cfg = qcom_ubwc_config_get_data();
 	if (IS_ERR(core->ubwc_cfg))
 		return PTR_ERR(core->ubwc_cfg);
