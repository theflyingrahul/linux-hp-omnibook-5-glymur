 drivers/media/platform/qcom/iris/iris_diag.c  | 81 +++++++++++++++++++
 drivers/media/platform/qcom/iris/iris_diag.h  | 14 ++++
 drivers/media/platform/qcom/iris/iris_probe.c |  5 ++
 7 files changed, 110 insertions(+), 3 deletions(-)
 create mode 100644 drivers/media/platform/qcom/iris/iris_diag.c
 create mode 100644 drivers/media/platform/qcom/iris/iris_diag.h

