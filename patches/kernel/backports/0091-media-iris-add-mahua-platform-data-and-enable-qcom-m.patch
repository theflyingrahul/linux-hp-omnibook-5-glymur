 .../platform/qcom/iris/iris_platform_vpu3x.c  | 34 ++++++++++++++
 drivers/media/platform/qcom/iris/iris_probe.c |  4 ++
 drivers/media/platform/qcom/iris/iris_vpu3x.c | 10 +++++
 7 files changed, 108 insertions(+)
 create mode 100644 drivers/media/platform/qcom/iris/iris_platform_mahua.c
 create mode 100644 drivers/media/platform/qcom/iris/iris_platform_mahua.h

