From e98c4a338e2a1d73528ddcdab57b986b2a87ee91 Mon Sep 17 00:00:00 2001
From: Rahul Pon <theflyingrahul@gmail.com>
Date: Sat, 26 Sep 2026 15:33:46 -0700
Subject: [PATCH 2/3] dmaengine: qcom: gpi: add ACPI support for the Glymur GPI
 engine

Snapdragon X2 (Glymur) laptops that boot through ACPI describe the GPI DMA
engine as QCOM0F88. Its _CRS lists only the GPIIs of the application
execution environment, one interrupt per GPII in order, and the memory
window starts 0x4000 bytes into the GPI block with the EE registers at
+0x10000.

Add an ACPI match with that layout, derive the GPII count from the ACPI
interrupt count, and export gpi_acpi_request_chan() so that a serial-engine
client found through _DEP can request its channel without a DT phandle.
DT behaviour is unchanged.

Tested on an HP OmniBook 5 16-bf1xxx: the EC I2C bus (IC10), which firmware
leaves in GSI mode, transfers through this engine.
---
 drivers/dma/qcom/gpi.c           | 129 +++++++++++++++++++++++++++----
 include/linux/dma/qcom-gpi-dma.h |  17 ++++
 2 files changed, 133 insertions(+), 13 deletions(-)

diff --git a/drivers/dma/qcom/gpi.c b/drivers/dma/qcom/gpi.c
index 6ef72dffd..6a47407c9 100644
--- a/drivers/dma/qcom/gpi.c
+++ b/drivers/dma/qcom/gpi.c
@@ -6,6 +6,7 @@
  */
 
 #include <dt-bindings/dma/qcom-gpi.h>
+#include <linux/acpi.h>
 #include <linux/bitfield.h>
 #include <linux/dma-mapping.h>
 #include <linux/dmaengine.h>
@@ -2201,6 +2202,91 @@ static struct dma_chan *gpi_of_dma_xlate(struct of_phandle_args *args,
 	return dma_get_slave_channel(&gchan->vc.chan);
 }
 
+/*
+ * ACPI (Snapdragon X2 Glymur, QCOM0F88): _CRS describes only the GPIIs that
+ * belong to the application EE, one interrupt per GPII in order, and the
+ * memory window starts @window_skip bytes into the GPI block.
+ */
+struct gpi_acpi_data {
+	u32 ee_offset;
+	u32 window_skip;
+};
+
+static const struct gpi_acpi_data gpi_acpi_glymur = {
+	.ee_offset = 0x10000,
+	.window_skip = 0x4000,
+};
+
+static struct platform_driver gpi_driver;
+static DEFINE_MUTEX(gpi_acpi_lock);
+
+/**
+ * gpi_acpi_request_chan() - request a channel of an ACPI-described GPI engine
+ * @dev: the GPI engine device (for example found through the client's _DEP)
+ * @chid: 0 for TX, 1 for RX
+ * @seid: serial engine index within the QUP
+ * @protocol: QCOM_GPI_* protocol
+ *
+ * ACPI has no equivalent of the DT "dmas" property for GPI; this performs the
+ * same lookup as the DT translation.
+ *
+ * Return: the channel, or an ERR_PTR (-EPROBE_DEFER until the engine binds).
+ */
+struct dma_chan *gpi_acpi_request_chan(struct device *dev, u32 chid, u32 seid,
+				       u32 protocol)
+{
+	struct of_phandle_args args = {
+		.args_count = 3,
+		.args = { chid, seid, protocol },
+	};
+	struct of_dma ofdma = {};
+	struct dma_chan *chan;
+
+	/*
+	 * Only an engine whose probe has completed, which includes
+	 * dma_async_device_register(), can hand out channels. The device lock
+	 * also keeps it bound while the channel is taken.
+	 */
+	device_lock(dev);
+	if (dev->driver != &gpi_driver.driver || !device_is_bound(dev)) {
+		device_unlock(dev);
+		return ERR_PTR(-EPROBE_DEFER);
+	}
+
+	ofdma.of_dma_data = dev_get_drvdata(dev);
+	mutex_lock(&gpi_acpi_lock);
+	chan = gpi_of_dma_xlate(&args, &ofdma);
+	mutex_unlock(&gpi_acpi_lock);
+	device_unlock(dev);
+
+	return chan ?: ERR_PTR(-EBUSY);
+}
+EXPORT_SYMBOL_GPL(gpi_acpi_request_chan);
+
+static int gpi_acpi_init(struct platform_device *pdev, struct gpi_dev *gpi_dev,
+			 u32 *ee_offset)
+{
+	const struct gpi_acpi_data *data = device_get_match_data(&pdev->dev);
+	int nirq;
+
+	if (!data)
+		return -ENODEV;
+	if ((gpi_dev->res->start & 0xffff) != data->window_skip)
+		return dev_err_probe(&pdev->dev, -ENODEV,
+				     "unexpected ACPI window %pR\n", gpi_dev->res);
+
+	nirq = platform_irq_count(pdev);
+	if (nirq < 0)
+		return nirq;
+	if (!nirq || nirq > 16)
+		return dev_err_probe(&pdev->dev, -ENODEV, "%d GPII interrupts\n", nirq);
+
+	gpi_dev->max_gpii = nirq;
+	gpi_dev->gpii_mask = GENMASK(nirq - 1, 0);
+	*ee_offset = data->ee_offset + data->window_skip;
+	return 0;
+}
+
 static int gpi_probe(struct platform_device *pdev)
 {
 	struct gpi_dev *gpi_dev;
@@ -2218,21 +2304,27 @@ static int gpi_probe(struct platform_device *pdev)
 		return PTR_ERR(gpi_dev->regs);
 	gpi_dev->ee_base = gpi_dev->regs;
 
-	ret = of_property_read_u32(gpi_dev->dev->of_node, "dma-channels",
-				   &gpi_dev->max_gpii);
-	if (ret) {
-		dev_err(gpi_dev->dev, "missing 'max-no-gpii' DT node\n");
-		return ret;
-	}
+	if (has_acpi_companion(&pdev->dev)) {
+		ret = gpi_acpi_init(pdev, gpi_dev, &ee_offset);
+		if (ret)
+			return ret;
+	} else {
+		ret = of_property_read_u32(gpi_dev->dev->of_node, "dma-channels",
+					   &gpi_dev->max_gpii);
+		if (ret) {
+			dev_err(gpi_dev->dev, "missing 'max-no-gpii' DT node\n");
+			return ret;
+		}
 
-	ret = of_property_read_u32(gpi_dev->dev->of_node, "dma-channel-mask",
-				   &gpi_dev->gpii_mask);
-	if (ret) {
-		dev_err(gpi_dev->dev, "missing 'gpii-mask' DT node\n");
-		return ret;
-	}
+		ret = of_property_read_u32(gpi_dev->dev->of_node, "dma-channel-mask",
+					   &gpi_dev->gpii_mask);
+		if (ret) {
+			dev_err(gpi_dev->dev, "missing 'gpii-mask' DT node\n");
+			return ret;
+		}
 
-	ee_offset = (uintptr_t)device_get_match_data(gpi_dev->dev);
+		ee_offset = (uintptr_t)device_get_match_data(gpi_dev->dev);
+	}
 	gpi_dev->ee_base = gpi_dev->ee_base - ee_offset;
 
 	gpi_dev->ev_factor = EV_FACTOR;
@@ -2328,6 +2420,10 @@ static int gpi_probe(struct platform_device *pdev)
 		return ret;
 	}
 
+	/* ACPI clients use gpi_acpi_request_chan() instead. */
+	if (!gpi_dev->dev->of_node)
+		return 0;
+
 	ret = of_dma_controller_register(gpi_dev->dev->of_node,
 					 gpi_of_dma_xlate, gpi_dev);
 	if (ret) {
@@ -2355,11 +2451,18 @@ static const struct of_device_id gpi_of_match[] = {
 };
 MODULE_DEVICE_TABLE(of, gpi_of_match);
 
+static const struct acpi_device_id gpi_acpi_match[] = {
+	{ "QCOM0F88", (kernel_ulong_t)&gpi_acpi_glymur },
+	{ }
+};
+MODULE_DEVICE_TABLE(acpi, gpi_acpi_match);
+
 static struct platform_driver gpi_driver = {
 	.probe = gpi_probe,
 	.driver = {
 		.name = KBUILD_MODNAME,
 		.of_match_table = gpi_of_match,
+		.acpi_match_table = gpi_acpi_match,
 	},
 };
 
diff --git a/include/linux/dma/qcom-gpi-dma.h b/include/linux/dma/qcom-gpi-dma.h
index f10fa9371..28f15001f 100644
--- a/include/linux/dma/qcom-gpi-dma.h
+++ b/include/linux/dma/qcom-gpi-dma.h
@@ -7,6 +7,9 @@
 #ifndef QCOM_GPI_DMA_H
 #define QCOM_GPI_DMA_H
 
+#include <linux/err.h>
+#include <linux/types.h>
+
 /**
  * enum spi_transfer_cmd - spi transfer commands
  * @SPI_TX: SPI peripheral TX command
@@ -101,4 +104,18 @@ struct gpi_i2c_config {
 	enum gpi_lock_action lock_action;
 };
 
+struct device;
+struct dma_chan;
+
+#if IS_ENABLED(CONFIG_QCOM_GPI_DMA)
+struct dma_chan *gpi_acpi_request_chan(struct device *dev, u32 chid, u32 seid,
+				       u32 protocol);
+#else
+static inline struct dma_chan *gpi_acpi_request_chan(struct device *dev, u32 chid,
+						     u32 seid, u32 protocol)
+{
+	return ERR_PTR(-ENODEV);
+}
+#endif
+
 #endif /* QCOM_GPI_DMA_H */
