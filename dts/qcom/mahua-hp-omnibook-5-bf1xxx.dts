// SPDX-License-Identifier: BSD-3-Clause
/*
 * HP OmniBook 5 16-bf1xxx, device tree for daily use: everything proven on
 * this laptop (2026-09-30, kernel -11):
 *  - the eDP OLED panel (kernel -4), the Adreno X2-85 GPU and CPU frequency
 *    scaling (-5, -7);
 *  - the ADSP and CDSP, PMIC GLink: battery, AC and USB-C charging (-6);
 *  - the USB-A port, both USB-C ports at high speed and SuperSpeed (-6)
 *    and the camera's controller (-8);
 *  - the embedded controller: fan speed, thermistors, mute LEDs and the
 *    keyboard backlight timeout (-9, -10).
 *
 * The -test device tree adds what is still being tested. The -minimal
 * device tree is the fallback when the display or GPU does not come up.
 */
/dts-v1/;

#include "mahua-hp-omnibook-5-bf1xxx.dtsi"

/ {
	model = "HP OmniBook 5 Laptop 16-bf1xxx";
	compatible = "hp,omnibook-5-16-bf1xxx", "qcom,mahua";

	/*
	 * PMIC GLink (battery, AC, UCSI, RTC; \_SB.PMGK in ACPI) is served by
	 * the SoCCP, which the boot firmware starts and Linux attaches to
	 * (remoteproc_soccp, early_boot, enabled in glymur.dtsi).
	 *
	 * USB-C (docs/usb-c-ports-2026-09-29.md): \_SB.URS0 (QCOM0F8B,
	 * dual-role, 0x0a600000) is usb_0 and \_SB.URS1 (QCOM0F8C,
	 * 0x0a800000) is usb_1. Their ports use _PLD PLD0 and PLD1, the same
	 * as the UCSI connectors UCN0 and UCN1 (_UPC type 0x09, Type-C), which
	 * the firmware reports as connectors 1 and 2 (reg 0 and 1 here).
	 * Connector 2 is the port away from the hinge (charging-watch,
	 * 2026-09-29), so connector 1 is the one next to it. Their PEP entries
	 * (LPCE, the Mahua branch) vote the usb30_prim / usb_0_phy and
	 * usb30_sec / usb_1_phy GDSCs.
	 *
	 * The connectors are wired as on the upstream Glymur laptops: high
	 * speed to the DWC3 controller, SuperSpeed to its QMP USB3/DP PHY,
	 * which is the orientation and mode switch that PMIC GLink's port
	 * notifications ask for before they are acknowledged. UCSI drives the
	 * data role through the controllers' usb-role-switch.
	 *
	 * Full and low speed fail on every port without the eUSB2 repeaters
	 * (a USB mouse, error -71); the -test device tree declares them.
	 * DisplayPort alternate mode is not described (mdss_dp0/dp1 stay
	 * disabled).
	 */
	pmic-glink {
		compatible = "qcom,glymur-pmic-glink",
			     "qcom,pmic-glink";
		#address-cells = <1>;
		#size-cells = <0>;

		/* Next to the hinge */
		connector@0 {
			compatible = "usb-c-connector";
			reg = <0>;
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					pmic_glink_hs_in: endpoint {
						remote-endpoint = <&usb_0_dwc3_hs>;
					};
				};

				port@1 {
					reg = <1>;

					pmic_glink_ss_in: endpoint {
						remote-endpoint = <&usb_0_qmpphy_out>;
					};
				};
			};
		};

		/* Away from the hinge */
		connector@1 {
			compatible = "usb-c-connector";
			reg = <1>;
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					pmic_glink_hs_in1: endpoint {
						remote-endpoint = <&usb_1_dwc3_hs>;
					};
				};

				port@1 {
					reg = <1>;

					pmic_glink_ss_in1: endpoint {
						remote-endpoint = <&usb_1_qmpphy_out>;
					};
				};
			};
		};
	};

	/*
	 * eDP panel power: HP's PEP recipe for GPU0 drives GPIO 70 high (and
	 * 18 high, 119 as edp0_hot). It is already on from firmware (boot-on).
	 */
	vreg_edp: regulator-edp {
		compatible = "regulator-fixed";

		regulator-name = "VREG_EDP_3P3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;

		gpio = <&tlmm 70 GPIO_ACTIVE_HIGH>;
		enable-active-high;

		pinctrl-0 = <&edp_pwr_en>;
		pinctrl-names = "default";

		regulator-boot-on;
	};
};

/*
 * SCMI: the CPUCP firmware writes SCMI replies without ringing the mailbox
 * doorbell, so interrupt-mode transfers time out (lab run 1). This is
 * "arm64: dts: qcom: glymur: use polling mode for SCMI transfers" (Jesse
 * Casco, 2026-08-08), applied at board level. scmi-cpufreq is still a
 * module, loaded by glymur-cpufreq.service.
 */
&{/firmware/scmi} {
	arm,no-completion-irq;
};

/*
 * GPU (docs/gpu-bringup-run1-2026-09-29.md): Windows binds this GPU as
 * "Adreno X2-85" (ACPI QCOM0FF5), the chip glymur.dtsi describes
 * (qcom,adreno-44070001, GMU x285.1). As on the upstream Glymur laptops
 * (ASUS Zenbook A16, HP EliteBook X G2q, HP OmniBook Ultra 14), no zap
 * shader is declared: the driver falls back to SECVID_TRUST_CNTL. It needs
 * qcom/gen80100_sqe.fw and gen80100_gmu.bin from linux-firmware. The
 * driver picks the OPPs from the chip's speed-bin fuse; the three OPPs
 * above 1.35 GHz (the ceiling every bin supports) are removed as well.
 */
&adreno_smmu {
	status = "okay";
};

&gmu {
	status = "okay";
};

&gpu {
	status = "okay";
};

&gpu_opp_table {
	/delete-node/ opp-1550000000;
	/delete-node/ opp-1700000000;
	/delete-node/ opp-1850000000;
};

&gpucc {
	status = "okay";
};

&gxclkctl {
	status = "okay";
};

/*
 * Embedded controller (docs/ec-2026-09-30.md): HP's \_SB.IC10 (0xa84000,
 * i2c9) with the EC at 0x76, 400 kHz (the ECIC/UMPC connections in HP's
 * SSDT and DSDT). IC10's PEP entry votes gcc_qupv3_wrap1_s1_clk and pins
 * 36/37 (function 1, pull-up), which is qup_i2c9_data_clk; firmware leaves
 * the controller in GSI (GPI DMA) mode, which i2c-qcom-geni detects and
 * runs through gpi_dma1. The EC's event line (F9/F11 hotkeys) is in the
 * -test device tree.
 */
&i2c9 {
	clock-frequency = <400000>;

	status = "okay";

	hp_ec: embedded-controller@76 {
		compatible = "hp,omnibook-5-16-bf1xxx-ec";
		reg = <0x76>;
	};
};

&mdss {
	status = "okay";
};

/*
 * Internal panel: EDID SDC 0x4214, "Integrated Monitor (ATNA60KJ02-0)" in
 * Windows, a Samsung ATNA OLED, 1920x1200, 8 bpc, eDP. The ATNA driver
 * handles AUX backlight and the power/enable sequence.
 */
&mdss_dp3 {
	/delete-property/ #sound-dai-cells;

	pinctrl-0 = <&edp0_hpd_default>;
	pinctrl-names = "default";

	status = "okay";

	aux-bus {
		panel {
			compatible = "samsung,atna33xc20";
			enable-gpios = <&tlmm 18 GPIO_ACTIVE_HIGH>;
			power-supply = <&vreg_edp>;

			pinctrl-0 = <&edp_bl_en>;
			pinctrl-names = "default";

			port {
				edp_panel_in: endpoint {
					remote-endpoint = <&mdss_dp3_out>;
				};
			};
		};
	};
};

&mdss_dp3_out {
	data-lanes = <0 1 2 3>;
	link-frequencies = /bits/ 64 <1620000000 2700000000 5400000000 8100000000>;

	remote-endpoint = <&edp_panel_in>;
};

&mdss_dp3_phy {
	status = "okay";
};

/*
 * HP-signed images from HP's driver pack (qcsubsys_ext_adsp8480,
 * qcnspmcdm8480); see boards/hp-omnibook-5-16-bf1xxx/firmware/README.md.
 */
&remoteproc_adsp {
	firmware-name = "qcom/glymur/HP/omnibook-5-16-bf1xxx/qcadsp8480.mbn",
			"qcom/glymur/HP/omnibook-5-16-bf1xxx/adsp_dtbs.elf";

	status = "okay";
};

&remoteproc_cdsp {
	firmware-name = "qcom/glymur/HP/omnibook-5-16-bf1xxx/qccdsp8480.mbn",
			"qcom/glymur/HP/omnibook-5-16-bf1xxx/cdsp_dtbs.elf";

	status = "okay";
};

/*
 * USB (docs/usb-a-bringup-2026-09-29.md, docs/usb-c-ports-2026-09-29.md,
 * docs/camera-usb-controller-2026-09-30.md):
 * - USB-A: \_SB.USB2 (QCOM0F9A) is the xHCI at 0x0a000000 with interrupts
 *   GIC SPI 871 and 370: usb_2. Its root-hub ports return _UPC type 0x03,
 *   USB 3 Standard-A, so the controller is host-only. Its PEP entry (LPCL)
 *   votes the usb30_tert and usb_2_phy GDSCs and the tcsr_usb2_4 /
 *   tcsr_usb4_2 reference clocks: usb_2 and its PHYs.
 * - Camera: the HP True Vision FHD camera (USB\VID_30C9&PID_00D9, RGB and
 *   IR functions) is a USB device on \_SB.USB4 (QCOM0FEF): 0x0a200000,
 *   GIC SPI 240 and 246 (ACPI 272, 278), one root-hub port. That is
 *   usb_hs, a high-speed-only DWC3 with its own M31 eUSB2 PHY, host only.
 *   Its ACPI resources also name GPIO 9, whose role is unknown; it stays
 *   reserved.
 * - Not declared, for all four controllers: PHY supplies. HP's PEP names
 *   the rails (usb_2: S7F, L15B, L4C, L7B, L4F, L1C, L2F, L1F; usb_0: S7F,
 *   L15B, L3F, L7B, L4H; usb_1: the same plus L1H), but this device tree
 *   has no RPMh regulators and the per-supply mapping is not evidenced.
 *   The rails stay as firmware left them; the PHY drivers get dummy
 *   regulators. Also not declared: HP's USB3 PHY tuning for usb_2
 *   (\_SB.USB2.PHYC, two register writes).
 */
&usb_0 {
	status = "okay";
};

&usb_0_dwc3_hs {
	remote-endpoint = <&pmic_glink_hs_in>;
};

&usb_0_hsphy {
	status = "okay";
};

&usb_0_qmpphy {
	status = "okay";
};

&usb_0_qmpphy_out {
	remote-endpoint = <&pmic_glink_ss_in>;
};

&usb_1 {
	status = "okay";
};

&usb_1_dwc3_hs {
	remote-endpoint = <&pmic_glink_hs_in1>;
};

&usb_1_hsphy {
	status = "okay";
};

&usb_1_qmpphy {
	status = "okay";
};

&usb_1_qmpphy_out {
	remote-endpoint = <&pmic_glink_ss_in1>;
};

&usb_2 {
	dr_mode = "host";
	/delete-property/ usb-role-switch;

	status = "okay";
};

&usb_2_hsphy {
	status = "okay";
};

&usb_2_qmpphy {
	status = "okay";
};

&usb_hs {
	dr_mode = "host";
	/delete-property/ usb-role-switch;

	status = "okay";
};

&usb_hs_phy {
	status = "okay";
};

&tlmm {
	/*
	 * Allow-list: 0-1 i2c0, 3 touchpad, 16-17 i2c4, 18 eDP backlight
	 * enable, 32-33 i2c8, 36-37 i2c9 (EC), 51 touchscreen, 56-59 uart14,
	 * 67 keyboard, 70 eDP power, 92 lid, 116 BT enable, 119 eDP HPD,
	 * 146-148 PCIe 4, 152-154 PCIe 5. Everything else, up to GPIO 250, is
	 * reserved.
	 */
	gpio-reserved-ranges = <2 1>, <4 12>, <19 13>, <34 2>, <38 13>,
			       <52 4>, <60 7>, <68 2>, <71 21>, <93 23>,
			       <117 2>, <120 26>, <149 3>, <155 96>;

	edp_bl_en: edp-bl-en-state {
		pins = "gpio18";
		function = "gpio";
		drive-strength = <16>;
		bias-disable;
	};

	edp_pwr_en: edp-pwr-en-state {
		pins = "gpio70";
		function = "gpio";
		drive-strength = <16>;
		bias-disable;
	};

	edp0_hpd_default: edp0-hpd-default-state {
		pins = "gpio119";
		function = "edp0_hot";
		bias-disable;
	};
};
