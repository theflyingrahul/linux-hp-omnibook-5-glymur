// SPDX-License-Identifier: BSD-3-Clause
/*
 * HP OmniBook 5 16-bf1xxx, minimal device tree: CPUs, storage, input, lid,
 * Wi-Fi and Bluetooth, on the firmware framebuffer. No display, GPU,
 * ADSP/CDSP or PMIC GLink; the SoCCP that the firmware starts is attached
 * as glymur.dtsi describes. This is the fallback when the full device tree
 * does not come up.
 */
/dts-v1/;

#include "mahua-hp-omnibook-5-bf1xxx.dtsi"

/ {
	model = "HP OmniBook 5 Laptop 16-bf1xxx (minimal)";
	compatible = "hp,omnibook-5-16-bf1xxx", "qcom,mahua";
};

/*
 * Leave the display to the firmware framebuffer. The display clock
 * controller reprograms its PLLs at probe and, with no MDSS consumer,
 * its sync_state would power off the MDSS GDSC; pd_ignore_unused does
 * not cover that path.
 */
&dispcc {
	status = "disabled";
};

&tlmm {
	/*
	 * Allow-list: everything except the pins this file uses is reserved,
	 * up to GPIO 250 (the TLMM has 251). Used: 0-1 i2c0, 3 touchpad,
	 * 16-17 i2c4, 32-33 i2c8, 51 touchscreen, 56-59 uart14, 67 keyboard,
	 * 92 lid, 116 BT enable, 146-148 PCIe 4, 152-154 PCIe 5.
	 */
	gpio-reserved-ranges = <2 1>, <4 12>, <18 14>, <34 17>, <52 4>,
			       <60 7>, <68 24>, <93 23>, <117 29>,
			       <149 3>, <155 96>;
};
