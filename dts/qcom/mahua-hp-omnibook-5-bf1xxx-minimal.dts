// SPDX-License-Identifier: BSD-3-Clause
/*
 * HP OmniBook 5 16-bf1xxx, minimal device tree: the full device tree with
 * the native display left out, so the firmware framebuffer stays lit.
 * The display-lab boot of this configuration (2026-09-28,
 * docs/lab-boot-state-2026-09-28.md) had working CPUs, storage, input,
 * lid, Wi-Fi, Bluetooth, and battery and AC over PMIC GLink. The ADSP and
 * CDSP boot HP's images, but nothing uses them yet: no audio. The two UCSI
 * power supplies register, but the USB-C ports do not work (no USB). Also
 * absent: USB, GPU, TPM, fan RPM, CPU frequency scaling and suspend. This
 * is the fallback when the full device tree's display does not come up.
 */
/dts-v1/;

#include "mahua-hp-omnibook-5-bf1xxx.dts"

/ {
	model = "HP OmniBook 5 Laptop 16-bf1xxx (minimal)";
};

/*
 * Leave the display to the firmware framebuffer. The display clock
 * controller reprograms its PLLs at probe and, with no MDSS consumer,
 * its sync_state would power off the MDSS GDSC; pd_ignore_unused does
 * not cover that path.
 */
&dispcc {
	status = "disabled";
};

&mdss {
	status = "disabled";
};

&mdss_dp3_phy {
	status = "disabled";
};

&vreg_edp {
	status = "disabled";
};

&tlmm {
	/*
	 * Allow-list: everything except the pins this file uses is reserved,
	 * up to GPIO 250 (the TLMM has 251). The eDP pins 18, 70 and 119 are
	 * reserved here: the firmware drives them and nothing in this tree
	 * does. Used: 0-1 i2c0, 3 touchpad, 16-17 i2c4, 32-33 i2c8,
	 * 51 touchscreen, 56-59 uart14, 67 keyboard, 92 lid, 116 BT enable,
	 * 146-148 PCIe 4, 152-154 PCIe 5.
	 */
	gpio-reserved-ranges = <2 1>, <4 12>, <18 14>, <34 17>, <52 4>,
			       <60 7>, <68 24>, <93 23>, <117 29>,
			       <149 3>, <155 96>;
};
