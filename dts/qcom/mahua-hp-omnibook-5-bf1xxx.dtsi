// SPDX-License-Identifier: BSD-3-Clause
/*
 * HP OmniBook 5 Laptop 16-bf1xxx (Snapdragon X2 Elite X2E84100, "Mahua").
 *
 * Every board value comes from this machine: HP's DSDT (decoded with
 * scripts/linux/acpi-crs-decode.py), HP's PEP power tables
 * (analyze-acpi-pep.py, parse-bsrc.py on the HP driver pack), the MADT and
 * the Windows device tree. See docs/device-tree-review-2026-09-28.md.
 * Qualcomm's mahua.dtsi describes the SoC.
 *
 * Deliberately conservative:
 *  - no RPMh regulators are declared, so Linux changes no PMIC rail and
 *    every rail stays as HP's firmware left it;
 *  - every TLMM pin that a board file does not use is reserved
 *    (gpio-reserved-ranges, set per .dts and checked by
 *    scripts/linux/check-dt-gpio-allowlist.py), so an unknown pin such as
 *    an EC reset can never be touched.
 */

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/gpio-keys.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>

/*
 * The die is Mahua, not a Glymur with a fused cluster. HP's DSDT serves
 * both dies and selects on \_SB.SDFE, which is 0xA8 here. For 0xA8 it
 * disables the "CPU Cluster 2" and "QMX2" thermal zones and the cluster 2
 * limits policy, exactly what mahua.dtsi deletes, and gives GPU0 the
 * MHID QCOM0FF5, the ID Windows binds on this laptop (0xA1 has GHID
 * QCOM0F36). mahua.dtsi removes cluster 2, TSENS 6/7 and PCIe 3a and sets
 * the Mahua interconnect, TLMM and TCSR compatibles.
 */
#include "mahua.dtsi"

/ {
	chassis-type = "laptop";

	aliases {
		i2c0 = &i2c0;
		i2c4 = &i2c4;
		i2c8 = &i2c8;
		serial1 = &uart14;
	};

	chosen {
	};

	/*
	 * Root clocks from the PMK8850 PMIC (PMIC "A": HP's PEP tables vote its
	 * CLK6_A/CLK7_A buffers). The 38.4 MHz XO and the 32 kHz sleep clock
	 * are properties of that PMIC, not board choices.
	 */
	clocks {
		sleep_clk: sleep-clk {
			compatible = "fixed-clock";
			clock-frequency = <32000>;
			#clock-cells = <0>;
		};

		xo_board: xo-board {
			compatible = "fixed-clock";
			clock-frequency = <38400000>;
			#clock-cells = <0>;
		};
	};

	/*
	 * Lid: \_SB.LID0._LID returns GIO0.LIDR, the level of GPIO 92, with
	 * 1 = open, so the line is low when closed. LIGE signals it on PDC
	 * pin 960 (GPIO 92), both edges.
	 */
	gpio-keys {
		compatible = "gpio-keys";

		pinctrl-0 = <&hall_int_n_default>;
		pinctrl-names = "default";

		switch-lid {
			label = "lid";
			gpios = <&tlmm 92 GPIO_ACTIVE_LOW>;
			linux,input-type = <EV_SW>;
			linux,code = <SW_LID>;
			wakeup-source;
			wakeup-event-action = <EV_ACT_DEASSERTED>;
		};
	};
};

/* HP I2C1 (0xb80000, PEP pins 0/1): keyboard ECKB QTEC0001 at 0x3a. */
&i2c0 {
	clock-frequency = <400000>;

	status = "okay";

	keyboard@3a {
		compatible = "hid-over-i2c";
		reg = <0x3a>;

		/* _DSM 3cdff6f7 function 1 returns 1. */
		hid-descr-addr = <0x1>;
		/* GpioInt level-low, wake, pull-up; PDC pin 704 = GPIO 67. */
		interrupts-extended = <&tlmm 67 IRQ_TYPE_LEVEL_LOW>;

		pinctrl-0 = <&kybd_default>;
		pinctrl-names = "default";

		wakeup-source;
	};
};

/* HP I2C5 (0xb90000, PEP pins 16/17): touchpad TCPD at 0x15. */
&i2c4 {
	clock-frequency = <400000>;

	status = "okay";

	/* ELAN0189 on this SKU (\_SB.SPID == 0). */
	touchpad@15 {
		compatible = "hid-over-i2c";
		reg = <0x15>;

		hid-descr-addr = <0x1>;
		/* GpioInt level-low, wake, pull-up; PDC pin 896 = GPIO 3. */
		interrupts-extended = <&tlmm 3 IRQ_TYPE_LEVEL_LOW>;

		pinctrl-0 = <&tpad_default>;
		pinctrl-names = "default";

		wakeup-source;
	};
};

/* HP I2C9 (0xa80000, PEP pins 32/33): touchscreen TSC1 at 0x10. */
&i2c8 {
	clock-frequency = <400000>;

	status = "okay";

	/* ELAN2513, present on this SKU (\_SB.SKID == 1). */
	touchscreen@10 {
		compatible = "hid-over-i2c";
		reg = <0x10>;

		hid-descr-addr = <0x1>;
		/* GpioInt level-low, pull-up, GPIO 51. No reset line in _CRS. */
		interrupts-extended = <&tlmm 51 IRQ_TYPE_LEVEL_LOW>;

		pinctrl-0 = <&ts_default>;
		pinctrl-names = "default";
	};
};

/*
 * PERST# and WAKE# come from HP's DSDT. The PCIe manager \_SB.QPPX
 * (QCOM0F96) lists one PERST# GpioIo per root port, PCI0-PCI7 in order:
 * PCI4 = GPIO 146 and PCI5 = GPIO 152, no pull. PCI4 and PCI5 each carry a
 * wake GpioInt (edge, active-low, pull-up, wake-capable) on the PDC pins
 * 384 and 448, which GIO0 maps to GPIO 148 and 154. PEP drives CLKREQ# on
 * 147 and 153 (function 1, pull-up).
 *
 * PCIe 4 (ACPI PCI4, DBI 0x78000000): the QCC2072 Wi-Fi module (17cb:1112,
 * HP 103c:8ef3). Its 3.3 V (GPIO 94) and enables (GPIO 116/117) stay as
 * firmware left them; GPIO 94 and 117 are reserved.
 */
&pcie4 {
	pinctrl-0 = <&pcie4_default>;
	pinctrl-names = "default";

	status = "okay";
};

&pcie4_phy {
	status = "okay";
};

&pcie4_port0 {
	reset-gpios = <&tlmm 146 GPIO_ACTIVE_LOW>;
	wake-gpios = <&tlmm 148 GPIO_ACTIVE_LOW>;
};

/* PCIe 5 (ACPI PCI5, DBI 0x7a000000): NVMe, the root filesystem. */
&pcie5 {
	pinctrl-0 = <&pcie5_default>;
	pinctrl-names = "default";

	status = "okay";
};

&pcie5_phy {
	status = "okay";
};

&pcie5_port0 {
	reset-gpios = <&tlmm 152 GPIO_ACTIVE_LOW>;
	wake-gpios = <&tlmm 154 GPIO_ACTIVE_LOW>;
};

&tlmm {
	tpad_default: tpad-default-state {
		pins = "gpio3";
		function = "gpio";
		bias-pull-up;
	};

	ts_default: ts-default-state {
		pins = "gpio51";
		function = "gpio";
		bias-pull-up;
	};

	kybd_default: kybd-default-state {
		pins = "gpio67";
		function = "gpio";
		bias-pull-up;
	};

	hall_int_n_default: hall-int-n-state {
		pins = "gpio92";
		function = "gpio";
		bias-disable;
	};

	pcie4_default: pcie4-default-state {
		clkreq-n-pins {
			pins = "gpio147";
			function = "pcie4_clk_req_n";
			drive-strength = <2>;
			bias-pull-up;
		};

		perst-n-pins {
			pins = "gpio146";
			function = "gpio";
			drive-strength = <2>;
			bias-disable;
		};

		wake-n-pins {
			pins = "gpio148";
			function = "gpio";
			drive-strength = <2>;
			bias-pull-up;
		};
	};

	pcie5_default: pcie5-default-state {
		clkreq-n-pins {
			pins = "gpio153";
			function = "pcie5_clk_req_n";
			drive-strength = <2>;
			bias-pull-up;
		};

		perst-n-pins {
			pins = "gpio152";
			function = "gpio";
			drive-strength = <2>;
			bias-disable;
		};

		wake-n-pins {
			pins = "gpio154";
			function = "gpio";
			drive-strength = <2>;
			bias-pull-up;
		};
	};
};

/*
 * The SoC debug UART (glymur.dtsi enables it; GPIO 86/87) is not used on
 * this laptop's DT boot. Disabled, its pins stay reserved.
 */
&uart21 {
	status = "disabled";
};

/*
 * glymur.dtsi enables the Adreno GPU, its GMU, clock controllers and SMMU
 * by default. msm binds an available GPU into the same DRM device as the
 * display, so a GPU that fails to come up would also take the panel down.
 * Until the GPU is proven on this laptop, the whole GPU block stays off
 * here and only the -gpu test device tree turns it on. From kernel -5 the
 * GPU clock drivers (CLK_GLYMUR_GPUCC: gpucc-glymur, gxclkctl) are built.
 */
&gpu {
	status = "disabled";
};

&gmu {
	status = "disabled";
};

&gpucc {
	status = "disabled";
};

&gxclkctl {
	status = "disabled";
};

&adreno_smmu {
	status = "disabled";
};

/*
 * HP UR15 (QUP_1_SE_6, 4-wire; UART pins 56-59 per HP's
 * BSRC_UART_4Wire_1.bin): QCC2072 Bluetooth (BTH0, QCOM0F6B). Windows runs
 * it at 3.2 Mbaud (qcbluetooth8480.inf BaudRate). BTH0's GpioIo is GPIO
 * 116, the Bluetooth enable (bt-enable on the Glymur/Mahua CRD too). With
 * enable-gpios, hci_qca drives BT_EN itself and needs no regulators for
 * QCC2072.
 */
&uart14 {
	status = "okay";

	bluetooth {
		compatible = "qcom,qcc2072-bt";
		enable-gpios = <&tlmm 116 GPIO_ACTIVE_HIGH>;
		max-speed = <3200000>;
	};
};
