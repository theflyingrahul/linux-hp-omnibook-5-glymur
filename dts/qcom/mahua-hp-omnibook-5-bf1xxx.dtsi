/*
 * HP OmniBook 5 Laptop 16-bf1xxx
 */

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/gpio-keys.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>

#include "mahua.dtsi"

/ {
	chassis-type = "laptop";

	aliases {
		i2c0 = &i2c0;
		i2c4 = &i2c4;
		i2c8 = &i2c8;
		serial1 = &uart14;
	};

	chosen {
	};

	clocks {
		sleep_clk: sleep-clk {
			compatible = "fixed-clock";
			clock-frequency = <32000>;
			#clock-cells = <0>;
		};

		xo_board: xo-board {
			compatible = "fixed-clock";
			clock-frequency = <38400000>;
			#clock-cells = <0>;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";

		pinctrl-0 = <&hall_int_n_default>;
		pinctrl-names = "default";

		switch-lid {
			label = "lid";
			gpios = <&tlmm 92 GPIO_ACTIVE_LOW>;
			linux,input-type = <EV_SW>;
			linux,code = <SW_LID>;
			wakeup-source;
			wakeup-event-action = <EV_ACT_DEASSERTED>;
		};
	};
};

&i2c0 {
	clock-frequency = <400000>;

	status = "okay";

	keyboard@3a {
		compatible = "hid-over-i2c";
		reg = <0x3a>;

		hid-descr-addr = <0x1>;
		interrupts-extended = <&tlmm 67 IRQ_TYPE_LEVEL_LOW>;

		pinctrl-0 = <&kybd_default>;
		pinctrl-names = "default";

		wakeup-source;
	};
};

&i2c4 {
	clock-frequency = <400000>;

	status = "okay";

	touchpad@15 {
		compatible = "hid-over-i2c";
		reg = <0x15>;

		hid-descr-addr = <0x1>;
		interrupts-extended = <&tlmm 3 IRQ_TYPE_LEVEL_LOW>;

		pinctrl-0 = <&tpad_default>;
		pinctrl-names = "default";

		wakeup-source;
	};
};

&i2c8 {
	clock-frequency = <400000>;

	status = "okay";

	touchscreen@10 {
		compatible = "hid-over-i2c";
		reg = <0x10>;

		hid-descr-addr = <0x1>;
		interrupts-extended = <&tlmm 51 IRQ_TYPE_LEVEL_LOW>;

		pinctrl-0 = <&ts_default>;
		pinctrl-names = "default";
	};
};

/* Wi-Fi */
&pcie4 {
	pinctrl-0 = <&pcie4_default>;
	pinctrl-names = "default";

	status = "okay";
};

&pcie4_phy {
	status = "okay";
};

&pcie4_port0 {
	reset-gpios = <&tlmm 146 GPIO_ACTIVE_LOW>;
	wake-gpios = <&tlmm 148 GPIO_ACTIVE_LOW>;
};

/* NVMe */
&pcie5 {
	pinctrl-0 = <&pcie5_default>;
	pinctrl-names = "default";

	status = "okay";
};

&pcie5_phy {
	status = "okay";
};

&pcie5_port0 {
	reset-gpios = <&tlmm 152 GPIO_ACTIVE_LOW>;
	wake-gpios = <&tlmm 154 GPIO_ACTIVE_LOW>;
};

&tlmm {
	tpad_default: tpad-default-state {
		pins = "gpio3";
		function = "gpio";
		bias-pull-up;
	};

	ts_default: ts-default-state {
		pins = "gpio51";
		function = "gpio";
		bias-pull-up;
	};

	kybd_default: kybd-default-state {
		pins = "gpio67";
		function = "gpio";
		bias-pull-up;
	};

	hall_int_n_default: hall-int-n-state {
		pins = "gpio92";
		function = "gpio";
		bias-disable;
	};

	pcie4_default: pcie4-default-state {
		clkreq-n-pins {
			pins = "gpio147";
			function = "pcie4_clk_req_n";
			drive-strength = <2>;
			bias-pull-up;
		};

		perst-n-pins {
			pins = "gpio146";
			function = "gpio";
			drive-strength = <2>;
			bias-disable;
		};

		wake-n-pins {
			pins = "gpio148";
			function = "gpio";
			drive-strength = <2>;
			bias-pull-up;
		};
	};

	pcie5_default: pcie5-default-state {
		clkreq-n-pins {
			pins = "gpio153";
			function = "pcie5_clk_req_n";
			drive-strength = <2>;
			bias-pull-up;
		};

		perst-n-pins {
			pins = "gpio152";
			function = "gpio";
			drive-strength = <2>;
			bias-disable;
		};

		wake-n-pins {
			pins = "gpio154";
			function = "gpio";
			drive-strength = <2>;
			bias-pull-up;
		};
	};
};

&uart21 {
	status = "disabled";
};

/* APSS CoreSight trace path, unused */
&{/etm-0} {
	status = "disabled";
};

&{/etm-1} {
	status = "disabled";
};

&{/etm-2} {
	status = "disabled";
};

&{/etm-3} {
	status = "disabled";
};

&{/etm-4} {
	status = "disabled";
};

&{/etm-5} {
	status = "disabled";
};

&{/etm-6} {
	status = "disabled";
};

&{/etm-7} {
	status = "disabled";
};

&{/etm-8} {
	status = "disabled";
};

&{/etm-9} {
	status = "disabled";
};

&{/etm-10} {
	status = "disabled";
};

&{/etm-11} {
	status = "disabled";
};

&{/soc@0/funnel@1d021000} {
	status = "disabled";
};

&{/soc@0/funnel@1d081000} {
	status = "disabled";
};

&{/soc@0/funnel@1d121000} {
	status = "disabled";
};

&{/soc@0/funnel@1d181000} {
	status = "disabled";
};

&{/soc@0/funnel@12080000} {
	status = "disabled";
};

&{/soc@0/replicator@1d0a0000} {
	status = "disabled";
};

&{/soc@0/replicator@1d0b0000} {
	status = "disabled";
};

&{/soc@0/replicator@1d0c0000} {
	status = "disabled";
};

&{/soc@0/replicator@1d0d0000} {
	status = "disabled";
};

&{/soc@0/replicator@1d0e0000} {
	status = "disabled";
};

&{/soc@0/replicator@1d1a0000} {
	status = "disabled";
};

&{/soc@0/replicator@1d1b0000} {
	status = "disabled";
};

&{/soc@0/replicator@1d1c0000} {
	status = "disabled";
};

&{/soc@0/replicator@1d1d0000} {
	status = "disabled";
};

&{/soc@0/replicator@1d1e0000} {
	status = "disabled";
};

&{/soc@0/replicator@1d090000} {
	status = "disabled";
};

&{/soc@0/replicator@1d190000} {
	status = "disabled";
};

&{/soc@0/tmc@1d029000} {
	status = "disabled";
};

&{/soc@0/tmc@1d129000} {
	status = "disabled";
};

/* The GPU is enabled by the board .dts */
&gpu {
	status = "disabled";
};

&gmu {
	status = "disabled";
};

&gpucc {
	status = "disabled";
};

&gxclkctl {
	status = "disabled";
};

&adreno_smmu {
	status = "disabled";
};

&uart14 {
	status = "okay";

	bluetooth {
		compatible = "qcom,qcc2072-bt";
		enable-gpios = <&tlmm 116 GPIO_ACTIVE_HIGH>;
		max-speed = <3200000>;
	};
};
