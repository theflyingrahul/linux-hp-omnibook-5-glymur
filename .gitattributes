* text=auto eol=lf
*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.md text eol=lf
*.json text eol=lf
*.tsv text eol=lf
*.patch text eol=lf -whitespace
*.cfg text eol=lf
*.c text eol=lf
*.manifest text eol=lf
Makefile text eol=lf
*.dts text eol=lf
*.dtsi text eol=lf
*.pdf binary
*.png binary
*.jpg binary
# Vendor files are committed byte-exact (hashes in MANIFEST.tsv).
boards/*/firmware/** -text -diff
boards/*/firmware/README.md text eol=lf
boards/*/firmware/MANIFEST.tsv text eol=lf
